{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "types": ["react-native"],
    "skipLibCheck": true
  },
  "include": ["src", "index.js", "*.d.ts"],
  // The web build's files are checked by tsconfig.web.json.
  "exclude": ["**/*.web.ts", "**/*.web.tsx", "web.d.ts"]
}
