# MQTT broker address — set to 127.0.0.1 when using the NixOS module (mosquitto runs locally)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

TOPIC_SIGNAL=open-lock-signal
TOPIC_STATE=open-lock-state
TOPIC_BATTERY=open-lock-battery
TOPIC_CURRENT=open-lock-current
MQTT_CLIENT_ID=web-controller

# Set to false and provide credentials below to require authentication
MQTT_ANON=true
MQTT_USERNAME=
MQTT_PASSWORD=

POLL_INTERVAL=2s
HTTP_ADDR=:8080

# Built web app (index.html at its root) to serve at /. Unset serves the API only.
# The NixOS module sets it to the web package.
UI_DIR=
